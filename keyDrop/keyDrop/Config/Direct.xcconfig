// Direct.xcconfig
// Developer ID / Gumroad distribution configuration.
// Use in Xcode: duplicate Debug/Release configurations as "Debug-Direct" / "Release-Direct"
// and set their Based on Configuration File to this xcconfig.

#include "Version.xcconfig"

KEYDROP_DISTRIBUTION_CHANNEL = DIRECT
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) KEYDROP_CHANNEL_DIRECT

CODE_SIGN_ENTITLEMENTS = keyDrop/keyDrop.Direct.entitlements
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application
PROVISIONING_PROFILE_SPECIFIER =
// Developer ID manual signing for direct distribution.

ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES

// Sparkle requires these linker flags for its XPC bundles to co-sign correctly during archive.
OTHER_CODE_SIGN_FLAGS = $(inherited) --timestamp --options=runtime

// Merge Sparkle configuration (SUFeedURL, SUPublicEDKey) into generated Info.plist.
INFOPLIST_FILE = Config/Info-Direct.plist
