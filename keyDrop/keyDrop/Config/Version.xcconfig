// Version.xcconfig
// Single source of truth for app version and team identity.
// Wire in Xcode: Project > Info > Configurations > set Debug + Release base config to this file.

MARKETING_VERSION = 1.1.4
CURRENT_PROJECT_VERSION = 7

DEVELOPMENT_TEAM = 83698ZGFJP
MACOSX_DEPLOYMENT_TARGET = 26.2
// PRODUCT_BUNDLE_IDENTIFIER intentionally kept at target level — Xcode's Signing editor reads it there.

// Distribution-channel flag. Overridden by MAS.xcconfig / Direct.xcconfig in Phase 2.
// Values: MAS | DIRECT
KEYDROP_DISTRIBUTION_CHANNEL = MAS
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) KEYDROP_CHANNEL_$(KEYDROP_DISTRIBUTION_CHANNEL)
