# Homebrew Cask template for keyDrop.
#
# Self-hosted tap: blas0/homebrew-keydrop. The official homebrew/cask repo
# requires notarized apps; keyDrop's current flow is an ad-hoc signed DMG in a
# maintainer-owned tap.

cask "keydrop" do
  version "1.1.6"
  sha256 "REPLACE_WITH_SHA256"

  url "https://github.com/blas0/keyDrop/releases/download/v#{version}/keyDrop-#{version}.dmg",
      verified: "github.com/blas0/keyDrop/"
  name "keyDrop"
  desc "Local macOS menu-bar vault for API keys"
  homepage "https://github.com/blas0/keyDrop"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: ">= :tahoe"

  app "keyDrop.app"

  zap trash: [
    "~/Library/Preferences/com.neurix.keydrop.plist",
    "~/Library/Application Support/com.neurix.keydrop",
    "~/Library/Caches/com.neurix.keydrop",
  ]
end
